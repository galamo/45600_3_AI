
OPENROUTER_API_KEY=sk-or-v1-...

PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin123
PG_DATABASE=vectordb
# not required — only for the use_mermaid_diagram tool
MCP_MERMAID_AUTH="<your-mermaid-mcp-authorization-header-value>"

# // mapping models
SQL_BASED_MODEL=openai/gpt-5.5-pro
TESTING_MODEL=openai/gpt-4o-mini
GENERATE_DATA_MODEL=openai/gpt-4o-mini

# Optional
# PORT=3002
# MCP_MERMAID_URL=https://mcp.mermaid.ai/mcp
# OPENAI_API_KEY=   (used only if OPENROUTER_API_KEY is empty)
# LLM_MAX_TOKENS=4096  (caps OpenRouter credit reservation; default 4096)

# Console flow logs (see readme "Reading the console logs")
# LOG_CHUNKS=1      # 0 = show only the retrieved-chunk count, not each chunk preview
# LOG_PREVIEW=120   # characters shown per chunk / answer preview
# FORCE_COLOR=1     # keep colors when stdout is not a TTY (e.g. docker compose)
# NO_COLOR=1        # disable colors
