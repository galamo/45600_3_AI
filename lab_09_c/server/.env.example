# ── Required ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ── Postgres (defaults match docker-compose.yml) ──────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin123
PG_DATABASE=vectordb

# Least-privilege role used ONLY by the SQL agent's tool (created by `npm run db:init`)
AGENT_DB_USER=agent_reader
AGENT_DB_PASSWORD=change-me-agent-reader

# ── Mermaid MCP (optional — diagrams still work without it) ───────────
MCP_MERMAID_AUTH="<your-mermaid-mcp-authorization-header-value>"
# MCP_MERMAID_URL=https://mcp.mermaid.ai/mcp

# ── Models (OpenRouter ids) ───────────────────────────────────────────
# supervisor, docs and diagram agents
TESTING_MODEL=openai/gpt-4o-mini
# SQL agent
SQL_BASED_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MAX_TOKENS=2048

# ── Server ────────────────────────────────────────────────────────────
PORT=3012
CORS_ORIGINS=http://localhost:5185
LOG_LEVEL=info

# ── Guardrail limits ──────────────────────────────────────────────────
MAX_QUESTION_CHARS=1000
MAX_HISTORY_TURNS=6
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=90000
RATE_LIMIT_PER_MINUTE=20

# Not used by this lab (kept for .env compatibility with lab 09 b / 16)
# GENERATE_DATA_MODEL=openai/gpt-4o-mini
