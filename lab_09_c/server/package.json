{
  "name": "lab-09-c-agents-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lab 09 c — production-style multi-agent server: supervisor + specialist agents (createAgent) orchestrated by LangGraph, with guardrails.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "mocha --import=tsx \"test/**/*.test.ts\"",
    "db:init": "tsx scripts/db-init.ts",
    "index:schema": "tsx scripts/index-schema.ts",
    "index:docs": "tsx scripts/index-docs.ts",
    "setup": "npm run db:init && npm run index:schema && npm run index:docs"
  },
  "dependencies": {
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/openai": "^1.8.5",
    "@langchain/openrouter": "^0.4.26",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "langchain": "^1.6.8",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
